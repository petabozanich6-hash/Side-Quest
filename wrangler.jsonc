{
  "name": "side-quest",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-10-01",
  "observability": { "enabled": true },
  "build": {
  "command": "npm --prefix worker install && npm --prefix frontend install --legacy-peer-deps && CI=false npm --prefix frontend run build"
  },
  "assets": {
    "directory": "./frontend/build",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "side-quest-db",
      "database_id": "1ac15034-9943-436d-bd44-b3fa2ea75646",
      "migrations_dir": "worker/migrations"
    }
  ]
}
