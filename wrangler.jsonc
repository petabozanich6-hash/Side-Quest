{
  "$schema": "./worker/node_modules/wrangler/config-schema.json",
  "name": "side-quest",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2025-10-01",
  "observability": { "enabled": true },
  "vars": { "STRIPE_LIVE_ENABLED": "true" },
  "build": {
    "command": "node worker/scripts/guard-build-branch.mjs && npm --prefix worker install && npm --prefix frontend install --legacy-peer-deps && CI=false npm --prefix frontend run build"
  },
  "assets": {
    "directory": "./frontend/build",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sidequest-db1",
      "database_id": "d26b63e2-d9e1-4021-b9c5-c494b607aa14",
      "migrations_dir": "./worker/migrations"
    }
  ],
  // Outgoing email (welcome email, and later password reset etc.).
  // Needs sidequestlearning.app onboarded under Compute > Email Service > Email Sending
  // in the Cloudflare dashboard. Until then sending fails quietly and the app carries on.
  "send_email": [{ "name": "EMAIL" }],
  // Cloudflare Workers AI for paid-plan lesson drafting (POST /api/ai/lesson-draft).
  // Only paid families can reach it (checked on the server), capped per family (see worker/src/aiDraft.ts).
  // Workers AI has a free daily allowance and is billed per use beyond it; check your Cloudflare plan.
  // Optional vars: AI_MODEL (default @cf/meta/llama-3.3-70b-instruct-fp8-fast), AI_GATEWAY_ID (route via an AI Gateway).
  "ai": { "binding": "AI" },
  // R2 storage for family files (paid membership). Match BUCKET in worker/src/types.ts.
  // The bucket must exist in the same Cloudflare account as this Worker.
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "sidequest-files" }
  ]
}
