{
  "name": "sidequest-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "db:migrate": "wrangler d1 execute sidequest-db --file=server/schema.sql",
    "db:migrate:local": "wrangler d1 execute sidequest-db --local --file=server/schema.sql",
    "db:seed": "wrangler d1 execute sidequest-db --file=server/seed.sql",
    "db:seed:local": "wrangler d1 execute sidequest-db --local --file=server/seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vite-tsconfig-paths": "^5.1.0",
    "wrangler": "^4.149.0"
  }
}
