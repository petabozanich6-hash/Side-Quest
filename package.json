{
  "name": "side-quest",
  "version": "1.0.0",
  "private": true,
  "description": "Side Quest Learning - React frontend + Cloudflare Worker (Hono + D1)",
  "scripts": {
    "build": "npm --prefix frontend install --legacy-peer-deps && CI=false npm --prefix frontend run build",
    "typecheck": "npm --prefix worker run typecheck",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "smoke": "node worker/test/smoke.mjs",
    "lessons:validate": "node lesson-excellence/scripts/validate.mjs lesson-excellence/content",
    "lessons:score": "node lesson-excellence/scripts/score.mjs lesson-excellence/content",
    "lessons:pipeline": "node lesson-excellence/scripts/pipeline.mjs",
    "lessons:test": "node --test lesson-excellence/test/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
