{
  // PRIVATE STAGING. Separate Worker and separate D1 database. Never points at production.
  // The database_id is filled in by the "Deploy staging" workflow (it creates sidequest-staging if missing).
  "name": "side-quest-staging",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./frontend/build",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sidequest-staging",
      "database_id": "REPLACED_BY_WORKFLOW",
      "migrations_dir": "./worker/migrations"
    }
  ]
}
