{
  // PRIVATE STAGING. Separate Worker and separate D1 database. Never points at production.
  // The database_id is filled in by the "Deploy staging" workflow (it creates sidequest-staging if missing).
  "name": "side-quest-staging",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  // Preserve dashboard-only variables; explicitly manage the staging mail binding.
  "keep_vars": true,
  "vars": {
    "STAGING_PRIVATE": "true",
    "SUPPORT_CLASSROOM_ENABLED": "true",
    "SUPPORT_GUEST_ENABLED": "true",
    "SUPPORT_GUEST_ORIGIN": "https://side-quest-staging.petabozanich6.workers.dev",
    "ADMIN_ORIGINS": "https://side-quest-staging.petabozanich6.workers.dev"
  },
  "send_email": [{ "name": "EMAIL" }],
  "assets": {
    "directory": "./frontend/build",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sidequest-staging",
      "database_id": "REPLACED_BY_WORKFLOW",
      "migrations_dir": "./worker/migrations"
    }
  ]
}
