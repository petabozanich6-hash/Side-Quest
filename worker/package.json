{
  "name": "side-quest-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy --config ../wrangler.jsonc",
    "db:migrate": "wrangler d1 migrations apply DB --remote --config ../wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config ../wrangler.jsonc"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
