{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "side-quest",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sidequest-db1",
      "database_id": "d26b63e2-d9e1-4021-b9c5-c494b607aa14"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sidequest-files"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
