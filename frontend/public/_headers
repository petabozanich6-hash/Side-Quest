# Every page: no framing by other sites (clickjacking), no MIME sniffing, no full URLs leaked to other
# sites, HTTPS only. The CSP deliberately leaves scripts and styles alone (they need their own testing);
# it only blocks plugins, base-tag hijacking and framing.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'

# The service worker and manifest must always be re-checked so app updates reach installed devices.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
/manifest-kids.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
/offline.html
  Cache-Control: no-cache
/offline
  Cache-Control: no-cache
